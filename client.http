	"novaSenha": "novaSenha123",
	"confirmarSenha": "novaSenha123"
}

### Auth - Logout (protegido)
POST {{baseUrl}}auth/logout
Authorization: Bearer {{authToken}}

### Listar cursos
GET {{baseUrl}}auth/me
Content-Type: application/json
Authorization: Bearer {{authToken}}



###########################################################################
# Cursos
###########################################################################

### Listar cursos
GET {{baseUrl}}cursos
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Criar curso
POST {{baseUrl}}cursos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Nome": "Introdução à Informtica",
	"Descricao": "introdutório sobre conceitos básicos",
	"ProfessorID": 5
}

### Buscar curso por id
GET {{baseUrl}}cursos/7
Content-Type: application/json
Authorization: Bearer {{authToken}}


### Atualizar curso
PUT {{baseUrl}}cursos/7
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Nome": "Introdução à Informatic",
	"Descricao": "introdutório sobre conceitos básicos"
}

### Remover curso
DELETE {{baseUrl}}cursos/7
Authorization: Bearer {{authToken}}


###########################################################################
# Professores
###########################################################################

### Listar professores
GET {{baseUrl}}professores
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Criar professor
POST {{baseUrl}}professores
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Nome": "Paulo da Silva",
	"Email": "paulo.silva@example.com",
	"Senha": "senhaProf123",
	"Departamento": "INFORMATICA",
	"CargaHoraria": 20
}

### Buscar professor
GET {{baseUrl}}professores/5
Authorization: Bearer {{authToken}}

### Atualizar professor
PUT {{baseUrl}}professores/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Nome": "João S."
}


###########################################################################
# Sumários
###########################################################################

### Listar sumários
GET {{baseUrl}}sumarios
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Criar sumário
POST {{baseUrl}}sumarios
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Conteudo": "Resumo da aula sobre Fastify",
	"Data": "2025-09-01T10:00:00.000Z",
	"CursoID": 2,
	"ProfessorID": 2
}

### Buscar sumário
GET {{baseUrl}}sumarios/1
Authorization: Bearer {{authToken}}

### Atualizar sumário
PUT {{baseUrl}}sumarios/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Conteudo": "Conteúdo atualizado do sumário"
}

### Deletar sumário
DELETE {{baseUrl}}sumarios/2
Authorization: Bearer {{authToken}}


###########################################################################
# Presenças
###########################################################################

### Listar presenças
GET {{baseUrl}}presencas
Authorization: Bearer {{authToken}}

### Registrar presença
POST {{baseUrl}}presencas
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Data": "2025-09-01T00:00:00.000Z",
	"ProfessorID": 1,
	"Estado": "PRESENTE"
}

### Gerar relatório
GET {{baseUrl}}reports/relatorios?startDate=2025-09-01T00:00:00.000Z&endDate=2025-09-02T00:00:00.000Z&departamento=INFORMATICA
Content-Type: application/json
Authorization: Bearer {{authToken}}

### listar dados do relatorio de faltas
GET {{baseUrl}}presencas/list/relatorios?startDate=2025-09-01T00:00:00.000Z&endDate=2025-12-22T00:00:00.000Z&departamento=INFORMATICA
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Registrar presenças em lote
POST {{baseUrl}}presencas/batch
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"presencas": [
		{ 
      "Data": "2025-09-01T00:00:00.000Z", 
      "ProfessorID": 3, 
      "Estado": "PRESENTE" 
      },
		{ 
      "Data": "2025-09-01T00:00:00.000Z", 
      "ProfessorID": 2, 
      "Estado": "FALTA" 
      }
	]
}

### Buscar presença por id
GET {{baseUrl}}presencas/2
Authorization: Bearer {{authToken}}

### Atualizar presença
PUT {{baseUrl}}presencas/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Estado": "FALTA"
}

### Remover presença
DELETE {{baseUrl}}presencas/1
Authorization: Bearer {{authToken}}


###########################################################################
# Efetividades
###########################################################################

### Listar efetividades
GET {{baseUrl}}efetividades
Authorization: Bearer {{authToken}}

### Criar efetividade
POST {{baseUrl}}efetividades
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Data": "2025-09-01T08:00:00.000Z",
	"HorasTrabalhadas": 4,
	"ProfessorID": 1
}

### Buscar efetividades por período
GET {{baseUrl}}efetividades/periodo?dataInicio=2025-09-01&dataFim=2025-09-28
Authorization: Bearer {{authToken}}

### Buscar efetividades de um professor
GET {{baseUrl}}efetividades/professor/1
Authorization: Bearer {{authToken}}

### Atualizar efetividade
PUT {{baseUrl}}efetividades/1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"HorasTrabalhadas": 8
}

### Remover efetividade
DELETE {{baseUrl}}efetividades/1
Authorization: Bearer {{authToken}}


###########################################################################
# Usuários
###########################################################################

### Listar usuários
GET {{baseUrl}}usuarios
Authorization: Bearer {{authToken}}

### Criar usuário
POST {{baseUrl}}usuarios
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"nome": "Maria",
	"email": "maria@example.com",
	"senha": "senhaUser1234",
	"tipo": "FUNCIONARIO"
}

### Buscar usuário
GET {{baseUrl}}usuarios/1
Authorization: Bearer {{authToken}}

### Atualizar usuário
PUT {{baseUrl}}usuarios/10
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"Nome": "Maria Silva"
}

### Atualizar senha do usuário
PUT {{baseUrl}}usuarios/1/senha
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
	"senhaAtual": "senhaUser123",
	"novaSenha": "novaSenhaUser123",
	"confirmarSenha": "novaSenhaUser123"
}


