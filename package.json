{
  "name": "swcs-backend",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/server.mjs",
  "scripts": {
    "start": "node dist/server.mjs",
    "build": "tsup src --format esm",
    "dev": "npm-run-all -p dev:*",
    "dev:server": "tsx watch --env-file .env src/server.ts",
    "dev:scheduler": "tsx --env-file=.env src/scheduler-cron.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "dev:docker:up": "docker-compose up -d",
    "dev:docker:down": "docker-compose down",
    "dev:docker:init": "npm run dev:docker:up && sleep 10 && npm run db:migrate && npm run db:generate && npm run db:seed && npm run db:studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "keywords": [],
  "author": "ronydevdesgn",
  "license": "ISC",
  "description": "O swcs é um sistema web para o controlo de sumário universitario...",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "6.19.2",
    "@prisma/config": "6.19.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.3.3",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "pg": "^8.20.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@tsconfig/node20": "^20.1.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.18.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "prisma": "^6.19.2",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  }
}
